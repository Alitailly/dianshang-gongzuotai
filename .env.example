# ------------------------------------------------------------
# RPA 门户网站环境变量示例
# 复制为项目根目录 .env 后按需修改
# server/lib/config.js 会自动读取项目根 .env 或 server/.env
# 注意: 已存在的系统环境变量优先级最高,不会被 .env 覆盖
# ------------------------------------------------------------

# 门户监听端口(默认 5055)
EXCEL_SERVER_PORT=5055

# 控制 bot 的鉴权 token,必须与所有 bot 电脑上的 RPA_CONTROL_TOKEN 完全一致
RPA_CONTROL_TOKEN=change-me-to-the-same-token-as-all-bots

# 可选: 首次启动创建 admin 账号时使用的初始密码;不填则随机生成并打印到控制台
# RPA_ADMIN_PASSWORD=change-me-admin-password

# 浏览器 Origin 白名单(逗号分隔)
# 不填时 start-local.sh 会自动加入本机所有 IPv4 地址,一般无需手动配置
# ALLOWED_ORIGINS=http://192.168.1.10:5055,http://localhost:5055,http://127.0.0.1:5055

# 可选: 星系核程序目录(仅网站机本地启动 bot/Chrome 时需要)
# GALAXY_DIR=/Users/yourname/Desktop/飞书多维表格管理工具星系核

# 可选: 门户认可的最新 bot 版本,默认 1.3.1; 一般无需修改
# LATEST_BOT_VERSION=1.3.1

# ===== 多模型自检（bot 侧读取，门户仅作示例）=====
# off / shadow / risk / all
# MULTI_MODEL_MODE=off
# DEEPSEEK_VERIFIER_MODELS=deepseek-chat,deepseek-reasoner
